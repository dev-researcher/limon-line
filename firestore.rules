rules_version = '2';

// Pegar en Firebase Console → Firestore → Reglas
// o desplegar con: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSalonReservation() {
      return request.resource.data.businessId == 'aaglamstudio';
    }

    function onlyProofOrPendingFields() {
      // Cliente público: solo puede adjuntar comprobante tras crear la reserva
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['payment', 'pending_confirmation']);
    }

    match /business_db/{businessId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /reservations_db/{reservationId} {
      allow read: if true;
      allow create: if isSalonReservation()
        && request.resource.data.keys().hasAll(['businessId', 'date', 'service'])
        && request.resource.data.amount is number
        && request.resource.data.amount <= 50000;
      allow update: if isSignedIn() || onlyProofOrPendingFields();
      allow delete: if isSignedIn();
    }

    match /monthly_reports/{reportId} {
      // Consulta y generación desde el panel admin
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.businessId == 'aaglamstudio';
      allow delete: if isSignedIn();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /events/{eventId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }
  }
}
