rules_version = '2';

// IMPORTANTE: hay que PUBLICAR estas reglas en Firebase Console.
// Sin publicarlas, Confirmar reserva siempre falla con permission-denied.
//
// Firestore → Reglas → pegar esto → Publicar
// https://console.firebase.google.com/project/sistema-reservas-1c8ef/firestore/rules

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /business_db/{businessId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /reservations_db/{reservationId} {
      allow read: if true;
      // Cliente público puede crear la cita (con o sin comprobante)
      allow create: if request.resource.data.businessId == 'aaglamstudio'
        && request.resource.data.keys().hasAll(['businessId', 'date', 'service', 'amount'])
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 50000;
      // Admin aprueba; cliente solo puede adjuntar comprobante
      allow update: if isSignedIn()
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['payment', 'pending_confirmation']);
      allow delete: if isSignedIn();
    }

    match /monthly_reports/{reportId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.businessId == 'aaglamstudio';
      allow delete: if isSignedIn();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /events/{eventId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }
  }
}
